  <Section name="Функции">

    <Category name="Ввод/вывод устройств">
      <Entry name="ic.read" signature="ic.read(pin, logicType [, networkIndex])" description="Считать логическое значение с устройства по индексу пина." example="local temp = ic.read(0, ic.enums.LogicType.Temperature)" />
      <Entry name="ic.write" signature="ic.write(pin, logicType, value [, networkIndex])" description="Записать логическое значение в устройство по индексу пина." example="ic.write(0, ic.enums.LogicType.Setting, 100)" />
      <Entry name="ic.read_id" signature="ic.read_id(refId, logicType [, networkIndex])" description="Считать логическое значение с устройства по ID ссылки." example="local v = ic.read_id(id, ic.enums.LogicType.On)" />
      <Entry name="ic.write_id" signature="ic.write_id(refId, logicType, value [, networkIndex])" description="Записать логическое значение в устройство по ID ссылки." example="ic.write_id(id, ic.enums.LogicType.On, 1)" />
      <Entry name="ic.read_slot" signature="ic.read_slot(pin, slot, slotLogicType [, networkIndex])" description="Считать логическое значение слота устройства по пину." example="local occ = ic.read_slot(0, 0, ic.enums.LogicSlotType.Occupied)" />
      <Entry name="ic.write_slot" signature="ic.write_slot(pin, slot, slotLogicType, value [, networkIndex])" description="Записать логическое значение слота устройства по пину." />
      <Entry name="ic.read_slot_id" signature="ic.read_slot_id(refId, slot, slotLogicType [, networkIndex])" description="Считать логическое значение слота устройства по ID ссылки." />
