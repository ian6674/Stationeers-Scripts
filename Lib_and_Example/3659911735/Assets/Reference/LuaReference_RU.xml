<?xml version="1.0" encoding="utf-8"?>
<!--
  Справочные данные Lua API для панели справки IC10Editor.
  Этот файл компилируется как EmbeddedResource и загружается LuaReferenceData.cs.
  
  Схема: <LuaReference> → <Section> → <Category> → <Entry>
  Каждый Entry имеет: name, signature, description и необязательный example.
  
  Поля name, signature и example остаются на английском — это идентификаторы кода.
  Переведены только описания (description).
-->
<LuaReference>

